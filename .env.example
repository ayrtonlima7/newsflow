# =============================================================================
# LLM providers
# =============================================================================

# Provider padrão (usado pelo curate; também pelo email se EMAIL_LLM_PROVIDER
# não estiver setado). Curate exige web search, então use gemini.
# Valores: anthropic | gemini | deepseek
# Obs: anthropic atualmente removido das deps.
LLM_PROVIDER=gemini

# Provider opcional só para a geração do email (não exige web search).
# DeepSeek é ~10x mais barato que Gemini 2.5 Pro pra essa etapa.
# Se omitido, usa LLM_PROVIDER.
EMAIL_LLM_PROVIDER=deepseek

# Provider opcional pra normalização de tópicos no save do perfil.
# Se omitido, cai em EMAIL_LLM_PROVIDER → LLM_PROVIDER.
# NORMALIZE_LLM_PROVIDER=deepseek

# Modelos por provider (sobrescrevíveis)
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-pro
DEEPSEEK_MODEL=deepseek-chat

# Chaves de API (preencha as que for usar)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# =============================================================================
# Email — Resend
# =============================================================================

RESEND_API_KEY=
# Sender precisa ser email num domínio verificado no Resend.
# Pra testes iniciais (só entrega pro dono da conta Resend): onboarding@resend.dev
RESEND_FROM=NewsFlow <oi@seu-dominio.com.br>

# Email de teste para o CLI `npm run send-test` (não afeta o pipeline real)
TEST_EMAIL_TO=

# Opcional: força destino em todos os deliveries (útil pra testar sem mandar
# pro usuário real). Em produção, deixe vazio.
# RESEND_OVERRIDE_TO=

# =============================================================================
# Supabase
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (formato novo: sb_publishable_*). Vai pro browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (formato novo: sb_secret_*). NUNCA expor ao browser.
SUPABASE_SECRET_KEY=

# =============================================================================
# App
# =============================================================================

# URL pública do app — usada nos links de feedback/unsubscribe dentro do email.
# Local: http://localhost:3000
# Produção: https://seu-projeto.vercel.app (ou domínio próprio)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret para autenticar o cron handler (gere com: openssl rand -hex 32).
# Em produção (Vercel), também é o secret que a Vercel usa pro Authorization
# Bearer no /api/cron/deliver.
CRON_SECRET=

# Email do admin — único usuário com acesso a /api/admin/stats.
# Quem logar com esse email no app consegue ver as stats no browser.
ADMIN_EMAIL=

# =============================================================================
# Misc
# =============================================================================

# Câmbio USD→BRL para logs de custo (atualize conforme o dólar muda)
USD_BRL_RATE=5.50
