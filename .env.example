# =============================================================================
# LLM providers
# =============================================================================

# Arquitetura: a busca web é feita pela TAVILY (não pelo LLM) — o DeepSeek apenas
# CURA os resultados reais. Por isso o provider NÃO precisa de web search.

# Provider padrão (curadoria + email, quando os específicos abaixo não são setados).
# Valores: gemini | deepseek (anthropic foi removido das deps). Na prática: deepseek.
LLM_PROVIDER=deepseek

# Provider da curadoria (recebe os resultados da Tavily e cura).
# Se omitido, usa LLM_PROVIDER.
CURATE_LLM_PROVIDER=deepseek

# Provider opcional só para a geração do email. Se omitido, usa LLM_PROVIDER.
EMAIL_LLM_PROVIDER=deepseek

# Provider opcional pra normalização de tópicos no save do perfil.
# Se omitido, cai em EMAIL_LLM_PROVIDER → LLM_PROVIDER.
# NORMALIZE_LLM_PROVIDER=deepseek

# Modelo usado pra derivação de domínios no save do perfil (só afeta pt).
# Default: deepseek-chat (rápido, barato, JSON mode, sempre popula content).
# Roda 1× por edição de perfil, não por entrega. NÃO use deepseek-reasoner aqui:
# o CoT consome o orçamento de tokens e o content volta vazio (cai no fallback).
# DERIVE_DOMAINS_MODEL=deepseek-chat

# Modelos por provider (sobrescrevíveis). Gemini é dormante (fallback, não usado).
GEMINI_MODEL=gemini-2.5-pro
DEEPSEEK_MODEL=deepseek-chat

# Chaves de API
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# Busca web — Tavily
# =============================================================================

# Backbone da busca: sem isso a curadoria não acha conteúdo (o curate NÃO usa
# web search do LLM). Pegue em app.tavily.com → API Keys.
TAVILY_API_KEY=

# =============================================================================
# Email — Resend
# =============================================================================

RESEND_API_KEY=
# Sender precisa ser email num domínio verificado no Resend.
# Produção: news@trynewsflow.com. Testes iniciais (só entrega pro dono da conta): onboarding@resend.dev
RESEND_FROM=NewsFlow <news@trynewsflow.com>

# Email de teste para o CLI `npm run send-test` (não afeta o pipeline real)
TEST_EMAIL_TO=

# Opcional: força destino em todos os deliveries (útil pra testar sem mandar
# pro usuário real). Em produção, deixe vazio.
# RESEND_OVERRIDE_TO=

# Tema visual do email: light (default, produção) | dark. Trocar pra dark é só
# setar isto — sem mexer no código. ⚠️ dark mode em email é instável em alguns
# clients (Gmail dark inverte cores); por isso o default é light.
# EMAIL_THEME=light

# =============================================================================
# Supabase
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (formato novo: sb_publishable_*). Vai pro browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (formato novo: sb_secret_*). NUNCA expor ao browser.
SUPABASE_SECRET_KEY=

# =============================================================================
# App
# =============================================================================

# URL pública do app — usada nos links de feedback/unsubscribe dentro do email.
# Local: http://localhost:3000
# Produção: https://trynewsflow.com
NEXT_PUBLIC_APP_URL=https://trynewsflow.com

# Secret para autenticar o cron handler (gere com: openssl rand -hex 32).
# Em produção (Vercel), também é o secret que a Vercel usa pro Authorization
# Bearer no /api/cron/deliver.
CRON_SECRET=

# Email do admin — único usuário com acesso a /api/admin/stats.
# Quem logar com esse email no app consegue ver as stats no browser.
ADMIN_EMAIL=

# Destino das mensagens da ouvidoria ("Fale com a gente" em /settings).
# Recomendado: um inbox dedicado que você lê (ex: gmail do NewsFlow).
# Se vazio, cai em ADMIN_EMAIL e, por fim, no próprio RESEND_FROM.
# Reply-To é sempre o email do usuário (você responde direto pra ele).
FEEDBACK_TO=

# =============================================================================
# Stripe — assinatura (test mode: keys sk_test_; produção: sk_live_)
# =============================================================================

STRIPE_SECRET_KEY=
# Signing secret do webhook (Stripe → Developers → Webhooks → seu endpoint).
# Em dev local, vem do `stripe listen` (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price IDs dos planos (Stripe → Products → Price). Começam com price_...
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=

# =============================================================================
# Analytics / funil — PostHog (OPCIONAL; tudo "dark" sem as envs)
# Mede o funil de aquisição (landing → onboarding → checkout). Ver docs/ANALYTICS.md.
# Sem NEXT_PUBLIC_POSTHOG_KEY, o módulo é no-op: não coleta, não carrega script.
# =============================================================================

# Project API Key do PostHog (phc_...) — é PÚBLICA de propósito (vai no client).
NEXT_PUBLIC_POSTHOG_KEY=
# Host de ingestão: US (https://us.i.posthog.com) ou EU (https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Pixels de plataforma de anúncio (OPCIONAIS — só ao ligar anúncios; conversion
# tracking DELAS, o funil detalhado é do PostHog).
# NEXT_PUBLIC_META_PIXEL_ID=          # Meta (Instagram/Facebook)
# NEXT_PUBLIC_GOOGLE_ADS_ID=          # Google: AW-XXXX (Ads) ou G-XXXX (GA4)

# =============================================================================
# Misc
# =============================================================================

# Câmbio USD→BRL para logs de custo (atualize conforme o dólar muda)
USD_BRL_RATE=5.50
