# Provedor padrão (curate + email se EMAIL_LLM_PROVIDER não setado)
# Valores: anthropic | gemini | deepseek
# Obs: anthropic atualmente removido das deps; usar gemini para curate (precisa de web search)
LLM_PROVIDER=gemini

# Provider opcional só para o email (sem web search, pode ser mais barato)
# Se omitido, usa LLM_PROVIDER. Ex: deepseek (~10x mais barato que gemini-2.5-pro)
EMAIL_LLM_PROVIDER=deepseek

# Modelos por provider (sobrescrevíveis)
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-pro
DEEPSEEK_MODEL=deepseek-chat

# Chaves de API (preencha as que for usar)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Resend (envio de email)
RESEND_API_KEY=
RESEND_FROM=NewsFlow <onboarding@resend.dev>
# Email de teste para o CLI send-test (não afeta o pipeline em produção)
TEST_EMAIL_TO=
# Opcional: força destino em todos os deliveries (útil pra testar sem mandar pro usuário real)
# RESEND_OVERRIDE_TO=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# URL pública do app (usada nos links de feedback dentro do email)
# Local: http://localhost:3000 — Produção: https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret para autenticar o cron handler (gere com: openssl rand -hex 32)
CRON_SECRET=

# Câmbio USD→BRL para logs de custo (atualize conforme o dólar muda)
USD_BRL_RATE=5.50
