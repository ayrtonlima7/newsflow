# Provedor padrão para curadoria e geração de email
# Valores: anthropic | gemini | deepseek
LLM_PROVIDER=anthropic

# Modelos por provider (sobrescrevíveis)
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-pro
DEEPSEEK_MODEL=deepseek-chat

# Chaves de API (preencha as que for usar)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Resend (envio de email de teste)
RESEND_API_KEY=
RESEND_FROM=NewsFlow <onboarding@resend.dev>
TEST_EMAIL_TO=

# Câmbio USD→BRL para logs de custo (atualize conforme o dólar muda)
USD_BRL_RATE=5.50
